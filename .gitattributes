# Auto detect text files and perform LF normalization on checkout/commit
* text=auto

# Source code files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.pyd binary
*.vsix binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.ico binary
