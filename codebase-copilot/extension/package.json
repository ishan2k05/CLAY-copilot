{
  "name": "clay-copilot",
  "displayName": "CLAY Copilot",
  "description": "Autonomous Repository Intelligence & Coding Agent Platform for VS Code",
  "version": "1.6.14",
  "publisher": "CLAYCopilot",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishan2k05/CLAY-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/ishan2k05/CLAY-copilot/issues"
  },
  "homepage": "https://github.com/ishan2k05/CLAY-copilot#readme",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Chat",
    "Programming Languages",
    "Machine Learning",
    "Testing",
    "Data Science",
    "Education",
    "Other"
  ],
  "keywords": [
    "ai",
    "copilot",
    "coding agent",
    "autonomous agent",
    "codebase",
    "chat",
    "assistant",
    "ollama",
    "tree-sitter",
    "code review",
    "refactor",
    "rag",
    "ast",
    "repository",
    "llm"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:codebaseCopilot.sidebarView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codebase-copilot",
          "title": "CLAY Copilot",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codebase-copilot": [
        {
          "type": "webview",
          "id": "codebaseCopilot.sidebarView",
          "name": "CLAY Copilot"
        }
      ]
    },
    "commands": [
      {
        "command": "codebaseCopilot.ask",
        "title": "CLAY Copilot: Ask Question"
      },
      {
        "command": "codebaseCopilot.analyzeRepo",
        "title": "CLAY Copilot: Analyze Repository"
      },
      {
        "command": "codebaseCopilot.explainSelection",
        "title": "CLAY Copilot: Explain Selected Code"
      },
      {
        "command": "codebaseCopilot.checkOllama",
        "title": "CLAY Copilot: Check Ollama Connection"
      },
      {
        "command": "codebaseCopilot.fixCurrentError",
        "title": "CLAY Copilot: Fix Current Error"
      },
      {
        "command": "codebaseCopilot.restartBackend",
        "title": "CLAY Copilot: Restart Backend Server"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codebaseCopilot.explainSelection",
          "when": "editorHasSelection",
          "group": "clay_copilot@1"
        },
        {
          "command": "codebaseCopilot.fixCurrentError",
          "group": "clay_copilot@2"
        },
        {
          "command": "codebaseCopilot.ask",
          "group": "clay_copilot@3"
        }
      ]
    },
    "configuration": {
      "title": "CLAY Copilot",
      "properties": {
        "codebaseCopilot.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "URL of the local CLAY Copilot Python FastAPI backend"
        },
        "codebaseCopilot.privacyFilter": {
          "type": "boolean",
          "default": true,
          "description": "Scrub secrets, keys, and .env contents before cloud transmission"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package:win32": "npm run compile && npx @vscode/vsce package --target win32-x64 -o codebase-copilot-win32-x64.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.88.0",
    "typescript": "^5.4.5"
  }
}
