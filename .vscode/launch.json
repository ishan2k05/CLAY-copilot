{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch CLAY Copilot (Extension Dev Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/codebase-copilot/extension"
      ],
      "outFiles": [
        "${workspaceFolder}/codebase-copilot/extension/out/**/*.js"
      ]
    }
  ]
}
